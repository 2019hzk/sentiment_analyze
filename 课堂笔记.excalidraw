    {
      "id": "3_F9saI248BodfoVA7Web",
      "type": "text",
      "x": -723.2380464682278,
      "y": 47552.6488120315,
      "width": 2667.6357421875,
      "height": 90,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c08W",
