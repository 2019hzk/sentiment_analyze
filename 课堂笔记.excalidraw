    {
      "id": "ecdggcKUswyCnRx7XoXDq",
      "type": "text",
      "x": -1818.9336907400566,
      "y": 19719.398178169216,
      "width": 418.13995361328125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
