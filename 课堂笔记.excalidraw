      "seed": 852220057,
      "version": 957,
      "versionNonce": 518235836,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1791770645108,
      "created": 1790218775065,
      "link": null,
      "locked": false,
      "text": "中间件：修改：自己逻辑的增强\nload_skill工具函数：修改：改的只是一个变量（共享变量）,服务于中间件修改。\n共享变量：某一个阶段的某一步动作将其修改，后续阶段都可以用到\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "中间件：修改：自己逻辑的增强\nload_skill工具函数：修改：改的只是一个变量（共享变量）,服务于中间件修改。\n共享变量：某一个阶段的某一步动作将其修改，后续阶段都可以用到\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Bk88gKITCDoX0Vxp5kkWe",
      "type": "rectangle",
      "x": -520.3654485090476,
      "y": 48758.180211442785,
      "width": 497.4280046114502,
      "height": 189.217711558078,
      "angle": 0,
