      "text": "“{\n  \"commands\": “[\n    “{\"command\": \"start_flow\", \"flow\": \"<flow_id>\"}”,\n    ”{\"command\": \"resume_flow\"}“,\n    “{\"command\": \"resume_flow\", \"flow\": \"<flow_id>\"}”,\n    ”{\"command\": \"cancel_flow\"}“,\n    “{\"command\": \"set_slots\", \"slots\": {\"<slot_name>\": \"<value>\"}}”\n  ]”\n}”",
