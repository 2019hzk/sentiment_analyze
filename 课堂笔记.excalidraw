    {
      "id": "JdgVTN_W7UL9cR8OzMNRm",
      "type": "text",
      "x": -2103.1636658805264,
      "y": 15531.906333300287,
      "width": 696.8199462890625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bbu",
      "roundness": null,
      "seed": 1851911357,
      "version": 723,
      "versionNonce": 779152878,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788834757759,
      "link": null,
      "locked": false,
      "text": "一次任务要驱动10次图的节点运行。但是10次的HostState对象没变\n第二次驱动图运行的各个节点可能会需要用到前一次的HostState中的属性。\n所以需要将每一次图运行完之后的状态，在送到下一次图运行的状态State中。",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "一次任务要驱动10次图的节点运行。但是10次的HostState对象没变\n第二次驱动图运行的各个节点可能会需要用到前一次的HostState中的属性。\n所以需要将每一次图运行完之后的状态，在送到下一次图运行的状态State中。",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
